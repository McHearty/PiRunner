{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitm.example/schemas/sprint-specification.schema.json",
  "title": "SprintSpecification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sprintNumber",
    "goals",
    "tasks",
    "acceptanceCriteria"
  ],
  "properties": {
    "masterSpecificationArtifactId": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "Required for feature development; null for surgical bug fixes" },
    "surgicalChange": { "type": "boolean", "description": "True when this is a surgical change on an existing codebase without a governing MasterSpecification" },
    "sprintNumber": { "type": "integer", "minimum": 1 },
    "goals": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requirementIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "requirementIds": { "type": "array", "items": { "type": "string" } }
        }
      },
      "minItems": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" }
        }
      },
      "minItems": 1
    }
  }
}
