{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitm.example/schemas/implementation-result.schema.json",
  "title": "ImplementationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "sprintSpecificationArtifactId",
    "testSpecificationArtifactId",
    "testSuiteContentHash",
    "commitSha",
    "changedFiles",
    "testsExecuted",
    "testSummary",
    "blockingIssues"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["COMPLETED", "BLOCKED", "FAILED"] },
    "sprintSpecificationArtifactId": { "type": "string" },
    "testSpecificationArtifactId": { "type": "string" },
    "testSuiteContentHash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "commitSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "changedFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "testsExecuted": { "type": "boolean" },
    "testSummary": {
      "type": "object",
      "required": ["passed", "failed", "skipped"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "blockingIssues": { "type": "array", "items": { "type": "string" } },
    "failureSignatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "location", "fingerprint"],
        "properties": {
          "class": { "type": "string" },
          "location": { "type": "string" },
          "fingerprint": { "type": "string" },
          "raw": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
