{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitm.example/schemas/concept-package.schema.json",
  "title": "ConceptPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objectives",
    "intendedUsers",
    "majorCapabilities",
    "constraints",
    "assumptions",
    "nonGoals",
    "terminology",
    "unresolvedQuestions"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "objectives": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "intendedUsers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "majorCapabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "nonGoals": { "type": "array", "items": { "type": "string" } },
    "terminology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string" },
          "definition": { "type": "string" }
        }
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "severity"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "IMPORTANT", "NICE_TO_HAVE"] }
        }
      }
    }
  }
}
