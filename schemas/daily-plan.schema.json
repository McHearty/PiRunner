{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitm.example/schemas/daily-plan.schema.json",
  "title": "DailyPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sprintSpecificationArtifactId",
    "dayNumber",
    "plannedTasks",
    "unresolvedQuestions"
  ],
  "properties": {
    "sprintSpecificationArtifactId": { "type": "string" },
    "dayNumber": { "type": "integer", "minimum": 1 },
    "plannedTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "description", "assignedAgentId"],
        "properties": {
          "taskId": { "type": "string" },
          "description": { "type": "string" },
          "assignedAgentId": { "type": "string", "pattern": "^\\d{4}$" }
        }
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "severity"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKING", "IMPORTANT", "NICE_TO_HAVE"] }
        }
      }
    }
  }
}
